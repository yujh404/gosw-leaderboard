# Neon pooled Postgres connection string. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
ADMIN_USERNAME=teacher
# Generate with pnpm admin:password. Paste the hash, not the password.
ADMIN_PASSWORD_HASH=
# At least 32 random characters; used only on the server.
AUTH_SECRET=
# Optional canonical public origin for QR codes. If empty, use the current origin.
NEXT_PUBLIC_APP_URL=
